# Template for /srv/carnaby-sk/.env on the NUC `carnaby-server` (next to docker-compose.prod.yml,
# deployed there as docker-compose.yml). NOT committed -- it holds real secrets; `chmod 600 .env`.

# Image tag to run. Production runs "latest" (CI publishes it from main; Watchtower follows it).
TAG=latest

# Public origin. Baked into the web image at CI build time (robots.txt/sitemap.xml/rewrites) AND
# read at runtime by both api and web -- see docker/docker-compose.prod.yml comments.
APP_URL=https://carnaby.sk

# Generate both secrets with: openssl rand -hex 32
DB_PASSWORD=openssl-rand-hex-32
BETTER_AUTH_SECRET=openssl-rand-hex-32

# Google OAuth client (Google Cloud Console -> Credentials). Redirect URI: <APP_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=copy-from-old-stack-env
GOOGLE_CLIENT_SECRET=copy-from-old-stack-env

# Comma-separated list of emails granted the admin role (applied at every sign-in, promote-only).
ADMIN_EMAILS=dodusik@gmail.com

# Optional: fixed bearer token for the MCP endpoint (https://carnaby.sk/api/mcp), for clients that
# can't do OAuth. Leave empty to allow OAuth only (Claude connectors don't need it). If set, use
# openssl-rand-hex-32 -- values shorter than 32 characters are ignored.
MCP_API_TOKEN=

# YouTube sync (docs/youtube.md). API key: Google Cloud Console -> enable "YouTube Data API v3" ->
# Credentials -> Create API key (restrict it to that API). Channels: handle or UC... id, optional
# =category slug for new posts, comma-separated, e.g. @carnaby=carnaby,@dodo=dodo
YOUTUBE_API_KEY=
YOUTUBE_CHANNELS=

# Umami analytics website id (same instance/site as v1 -- shared analytics.carnaby.sk deployment).
UMAMI_WEBSITE_ID=0733e169-1bc1-4990-a65f-2442fbb00237
