# Template for /volume1/docker/carnaby-sk-v2/.env on the NAS.
# Copy this file there as `.env` (NOT committed -- it holds real secrets), fill in the real
# values below, then `chmod 600 .env`. See docs/deploy/nas-runbook.md for the full first-deploy
# walkthrough.

# Image tag to run. "dev" while staging on :3200 (Tasks 28-30; the plan said 3100, but 3100 is
# occupied on the NAS -- see the port note in docs/deploy/nas-runbook.md); switch to "latest" at
# cutover (Task 31) once CI has published :latest from main.
TAG=dev

# Public origin. Baked into the web image at CI build time (robots.txt/sitemap.xml/rewrites) AND
# read at runtime by both api and web -- see docker/docker-compose.nas.yml comments. Use the real
# public URL even while staging on :3200; do not put the :3200 staging URL here.
APP_URL=https://carnaby.sk

# Generate both secrets with: openssl rand -hex 32
DB_PASSWORD=openssl-rand-hex-32
BETTER_AUTH_SECRET=openssl-rand-hex-32

# Copy verbatim from the OLD stack's env on the NAS:
#   ssh -p 2222 carnaby@192.168.1.41 "grep GOOGLE /volume1/docker/carnaby-sk/.env"
GOOGLE_CLIENT_ID=copy-from-old-stack-env
GOOGLE_CLIENT_SECRET=copy-from-old-stack-env

# Comma-separated list of emails granted the admin role on first login.
ADMIN_EMAILS=dodusik@gmail.com

# Umami analytics website id (same instance/site as v1 -- shared analytics.carnaby.sk deployment).
UMAMI_WEBSITE_ID=0733e169-1bc1-4990-a65f-2442fbb00237
